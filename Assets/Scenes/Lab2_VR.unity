  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 24
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\u041B\u0456\u0432\u0430/\u043F\u0440\u0430\u0432\u0430 \u0440\u0443\u043A\u0430:
    \u0442\u0440\u0438\u0433\u0435\u0440 \u2014 \u0432\u0437\u044F\u0442\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442,
    \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438\u0442\u0438 \u2014 \u043A\u0438\u043D\u0443\u0442\u0438\n\u0421\u0442\u0456\u043A
    \u0443\u043F\u0435\u0440\u0435\u0434 + \u0442\u0440\u0438\u0433\u0435\u0440 \u2014
    \u043F\u0440\u043E\u043C\u0456\u043D\u044C \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0430\u0446\u0456\u0457
    (Teleport Area / Anchor)\n\u041B\u0456\u0432\u0438\u0439 \u0441\u0442\u0456\u043A
    \u2014 \u043F\u043B\u0430\u0432\u043D\u0438\u0439 \u0440\u0443\u0445 \u0456\u0437
    \u0437\u0430\u0442\u0456\u043D\u0435\u043D\u043D\u044F\u043C \u043F\u0435\u0440\u0438\u0444\u0435\u0440\u0456\u0457
    (Comfort Vignette)\n\u041F\u0440\u0430\u0432\u0438\u0439 \u0441\u0442\u0456\u043A
    \u2014 \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0440\u0438\u0432\u043A\u0430\u043C\u0438"
